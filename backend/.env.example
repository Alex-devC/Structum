# ==============================================================================
# STRUCTUM BACKEND — Variáveis de Ambiente do Módulo de API
# ==============================================================================

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# CORS_ORIGIN: opcional. Se não definido, aceita a origem real do chamador.
CORS_ORIGIN=*

# DATABASE_URL: OPCIONAL para inicialização em modo de desenvolvimento.
# Não defina nem invente credenciais se estiver desenvolvendo sem banco configurado.
# DATABASE_URL=mysql://usuario:senha@localhost:3306/structum_db
