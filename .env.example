# ==============================================================================
# STRUCTUM — Configurações de Ambiente (Arquivo de Exemplo)
# ATENÇÃO: NUNCA insira senhas, chaves privadas ou credenciais reais aqui.
# ==============================================================================

# Ambiente de Execução (development | production | test)
NODE_ENV="development"

# Servidor Backend
PORT="3000"
HOST="0.0.0.0"
LOG_LEVEL="info"

# Origens permitidas para CORS:
# Opcional. Se omitido ou "*", reflete a origem real do frontend em tempo de execução
# (incluindo domínios do Google AI Studio / Cloud Run injetados via APP_URL).
CORS_ORIGIN="*"

# Configurações do Frontend (Vite)
# Opcional. Deixe vazio para utilizar caminhos relativos do mesmo host/proxy
# VITE_API_BASE_URL=""

# Conexão com o Banco de Dados (Prisma ORM):
# NOTA: DATABASE_URL NÃO é obrigatória para executar a API em desenvolvimento.
# Para desenvolver sem banco de dados, deixe esta variável comentada.
#
# Exemplo para quando houver banco local provisionado (MySQL):
# DATABASE_URL="mysql://usuario:senha@localhost:3306/structum_db"
#
# Exemplo para futura migração (PostgreSQL):
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/structum_db?schema=public"

# Variáveis do Cloud Run / AI Studio (injetadas automaticamente pela plataforma)
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
